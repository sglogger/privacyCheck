services:
  hidden-homepage:
    build: .
    image: hidden-homepage
    container_name: hidden-homepage
    restart: unless-stopped
    ports:
      - "3010:3000"
    environment:
      - PORT=3000
      - NODE_ENV=production
      # Traceroute hop masking — hide the boring leading hops (own gateway / ISP edge):
      # - TRACEROUTE_HIDE_PRIVATE=false        # keep private/RFC1918 leading hops (default: hide)
      # - TRACEROUTE_HIDE_RANGES=193.239.20.0/22,100.64.0.0/10   # CIDRs to also hide (default: 193.239.20.0/22)
    # traceroute / nmap -O need raw sockets. Grant the capability to enable the
    # active probes; remove this block if you only want passive analysis.
    cap_add:
      - NET_RAW
      - NET_ADMIN
